{
  "name": "@akshatdev/relay",
  "description": "Developer review platform — QA, security, release, architecture",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "relay": "./packages/cli/dist/cli.js"
  },
  "files": [
    "packages/cli/dist",
    "README.md"
  ],
  "dependencies": {
    "c12": "^2.0.1",
    "citty": "^0.1.6",
    "consola": "^3.2.3",
    "fast-glob": "^3.3.2",
    "jiti": "^2.4.2",
    "mlly": "^1.7.4",
    "simple-git": "^3.27.0",
    "zod": "^3.24.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.12",
    "@types/node": "^20.11.24",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
